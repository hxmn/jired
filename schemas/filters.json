{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/filters/1",
  "title": "jired filters result",
  "description": "Saved filters this account owns or has starred",
  "type": "object",
  "required": [
    "schema",
    "listing",
    "filters"
  ],
  "properties": {
    "schema": {
      "const": "jired/filters/1"
    },
    "listing": {
      "enum": [
        "all",
        "mine",
        "favourite"
      ],
      "description": "What was asked for. On Data Center every listing is read out of the favourites, there being no other"
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter"
      }
    }
  },
  "$defs": {
    "filter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "jql",
        "favourite",
        "share_permissions",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "id",
            "display_name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "The account id on Cloud, the username on Data Center"
            },
            "display_name": {
              "type": "string"
            }
          }
        },
        "jql": {
          "type": "string"
        },
        "favourite": {
          "type": "boolean",
          "description": "Whether this account has it starred"
        },
        "share_permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/share"
          },
          "description": "Empty when the filter is private"
        },
        "url": {
          "type": "string",
          "description": "The issue navigator with the filter applied: `…/issues/?filter=ID`"
        }
      }
    },
    "share": {
      "type": "object",
      "required": [
        "type",
        "spec"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "description": "What `filter share --remove` also takes"
        },
        "type": {
          "enum": [
            "project",
            "project_role",
            "group",
            "user",
            "authenticated",
            "global"
          ]
        },
        "spec": {
          "type": "string",
          "description": "The `--share` spelling: `project:TSK`, `project:TSK/Developers`, `group:G`, `user:U`, `authenticated`, `global`"
        },
        "project": {
          "type": [
            "string",
            "null"
          ],
          "description": "The project key"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "id",
            "display_name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "The account id on Cloud, the username on Data Center"
            },
            "display_name": {
              "type": "string"
            }
          }
        }
      }
    },
    "call": {
      "type": "object",
      "required": [
        "method",
        "path",
        "body"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "`{id}` stands for the id of a filter a dry run has not made"
        },
        "body": {
          "description": "null for the calls that carry none"
        }
      }
    }
  }
}
