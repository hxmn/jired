{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/report-time/1",
  "title": "jired report time result",
  "description": "Time booked in a window, totalled per person and per issue",
  "type": "object",
  "required": [
    "schema",
    "days",
    "since",
    "until",
    "dates",
    "seconds",
    "staged_seconds",
    "by_day",
    "entries",
    "skipped",
    "people",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "jired/report-time/1"
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "description": "Whole days counted, one column each"
    },
    "since": {
      "type": "string",
      "description": "Midnight UTC of the first day counted, ISO-8601"
    },
    "until": {
      "type": "string",
      "description": "Midnight UTC of the day after the last one counted, ISO-8601"
    },
    "dates": {
      "type": "array",
      "description": "The day each column stands for, oldest first. Every by_day array in this document is in this order and of this length.",
      "items": {
        "type": "string",
        "description": "YYYY-MM-DD, UTC"
      }
    },
    "project": {
      "type": [
        "string",
        "null"
      ],
      "description": "The project the workspace is scoped to, if it has one"
    },
    "last_fetch_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the snapshot behind the report was last refreshed"
    },
    "last_fetch_age_seconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Everything booked in the window"
    },
    "staged_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "The part of `seconds` not yet pushed to Jira"
    },
    "by_day": {
      "$ref": "#/$defs/by_day",
      "description": "Column totals: what everyone booked on each day"
    },
    "entries": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "description": "Worklogs with no readable start or duration, left out"
    },
    "people": {
      "type": "array",
      "description": "Most time first, then by name",
      "items": {
        "type": "object",
        "required": [
          "name",
          "account_id",
          "also_known_as",
          "seconds",
          "staged_seconds",
          "by_day",
          "entries",
          "issues"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The display name on the person's most recent entry"
          },
          "account_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the server identifies them by (accountId on Cloud, the user name on Data Center), and what people are grouped by. Null for time the snapshots cannot attribute."
          },
          "also_known_as": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Earlier display names of the same account, seen on older entries"
          },
          "seconds": {
            "type": "integer",
            "minimum": 0
          },
          "staged_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "by_day": {
            "$ref": "#/$defs/by_day"
          },
          "entries": {
            "type": "integer",
            "minimum": 0
          },
          "issues": {
            "type": "array",
            "description": "Most time first, then by key",
            "items": {
              "type": "object",
              "required": [
                "key",
                "summary",
                "type",
                "parent",
                "rolled_up",
                "seconds",
                "staged_seconds",
                "by_day",
                "entries"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "description": "Issue type, empty when nothing knows it"
                },
                "parent": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The issue's parent key"
                },
                "rolled_up": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Under --rollup parent, the sub-tasks whose time this row carries"
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "staged_seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "by_day": {
                  "$ref": "#/$defs/by_day"
                },
                "entries": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "The same time the other way up: a row per issue (per top-level parent under --rollup parent), most time first",
      "items": {
        "type": "object",
        "required": [
          "key",
          "summary",
          "type",
          "parent",
          "rolled_up",
          "seconds",
          "staged_seconds",
          "by_day",
          "entries",
          "people"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Issue type, empty when nothing knows it"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "The issue's parent key"
          },
          "rolled_up": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Under --rollup parent, the sub-tasks whose time this row carries"
          },
          "seconds": {
            "type": "integer",
            "minimum": 0
          },
          "staged_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "by_day": {
            "$ref": "#/$defs/by_day"
          },
          "entries": {
            "type": "integer",
            "minimum": 0
          },
          "people": {
            "type": "array",
            "description": "Who booked it, in the order of the top-level people",
            "items": {
              "type": "object",
              "required": [
                "name",
                "account_id",
                "seconds"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "account_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "rollup": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "parent",
        null
      ],
      "description": "`parent` when sub-tasks were folded into the issue at the top of their chain"
    }
  },
  "$defs": {
    "by_day": {
      "type": "array",
      "description": "Seconds booked on each day of `dates`, in that order",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
