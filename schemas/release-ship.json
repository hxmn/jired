{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/release-ship/1",
  "title": "jired release ship result",
  "description": "A version released, and what it shipped unfinished or moved on",
  "type": "object",
  "required": [
    "schema",
    "dry_run",
    "released",
    "project",
    "version",
    "request",
    "unfinished",
    "moved_to",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "jired/release-ship/1"
    },
    "dry_run": {
      "type": "boolean",
      "description": "True when --dry-run was given: nothing was sent"
    },
    "released": {
      "type": "boolean",
      "description": "False on a dry run, and when moving the unfinished issues failed and the release was abandoned"
    },
    "project": {
      "type": "string"
    },
    "version": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "name",
        "released",
        "archived"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "released": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "A day, `2026-10-15`: Jira keeps a version's dates without a time or a zone"
        },
        "release_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "A day, `2026-10-29`"
        }
      },
      "description": "The version as the server now holds it; null when `released` is false"
    },
    "request": {
      "type": "object",
      "required": [
        "method",
        "path",
        "body"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "body": {
          "type": "object"
        }
      },
      "description": "The releasing call, sent unless dry_run"
    },
    "unfinished": {
      "type": "array",
      "description": "The issues this workspace has in the version that are not in a `done` status",
      "items": {
        "type": "object",
        "required": [
          "key",
          "file",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "moved_to": {
      "type": [
        "object",
        "null"
      ],
      "description": "The version --move-unfixed-to named; null without it",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "One entry per issue file the move wrote; empty without --move-unfixed-to",
      "items": {
        "type": "object",
        "required": [
          "key",
          "file",
          "changed"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          }
        }
      }
    },
    "push": {
      "type": [
        "object",
        "null"
      ],
      "description": "A jired/push/1 document for the move, when there was one"
    }
  }
}
