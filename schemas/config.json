{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/config/1",
  "title": "jired config result",
  "description": "A single configuration value",
  "type": "object",
  "required": [
    "schema",
    "key"
  ],
  "properties": {
    "schema": {
      "const": "jired/config/1"
    },
    "key": {
      "type": "string"
    },
    "value": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "removed": {
      "type": "boolean"
    },
    "values": {
      "type": "array",
      "description": "Every value of a list setting, after `config add`/`remove`",
      "items": {
        "type": "string"
      }
    },
    "changed": {
      "type": "boolean",
      "description": "Whether `config add`/`remove` actually altered the list"
    },
    "rewritten": {
      "type": "array",
      "description": "Issue files `config add`/`remove ignored_custom_fields` brought into line with the new list, in a workspace",
      "items": {
        "type": "object",
        "required": ["file", "change"],
        "properties": {
          "file": { "type": "string" },
          "change": { "type": "string" }
        }
      }
    }
  }
}
