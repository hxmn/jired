{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/log/1",
  "title": "jired log result",
  "description": "Changelog entries, newest first: one issue's, or the whole workspace's",
  "type": "object",
  "required": [
    "schema",
    "key",
    "scope",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "jired/log/1"
    },
    "scope": {
      "description": "`issue` when an issue was named, `workspace` when the log covers every issue",
      "enum": [
        "issue",
        "workspace"
      ]
    },
    "key": {
      "description": "The issue asked for; null when the log covers the whole workspace",
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "description": "The issue this entry belongs to",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "created": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "field"
              ]
            }
          }
        },
        "required": [
          "key",
          "id",
          "items"
        ]
      }
    }
  }
}
