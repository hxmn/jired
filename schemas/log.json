{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/log/1",
  "title": "jired log result",
  "description": "Issue changelog, newest first",
  "type": "object",
  "required": [
    "schema",
    "key",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "jired/log/1"
    },
    "key": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "created": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "field"
              ]
            }
          }
        },
        "required": [
          "id",
          "items"
        ]
      }
    }
  }
}
