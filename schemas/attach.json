{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/attach/1",
  "title": "jired attach result",
  "description": "Files staged for upload",
  "type": "object",
  "required": [
    "schema",
    "key",
    "staged",
    "pushed"
  ],
  "properties": {
    "schema": {
      "const": "jired/attach/1"
    },
    "key": {
      "type": "string"
    },
    "staged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pushed": {
      "type": "boolean"
    },
    "push": {
      "type": [
        "object",
        "null"
      ],
      "description": "A jired/push/1 document when --push was given"
    }
  }
}
