{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/push/1",
  "title": "jired push result",
  "type": "object",
  "required": [
    "dry_run",
    "results",
    "schema",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "jired/push/1"
    },
    "dry_run": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "ok",
          "ops"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "new_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Real key assigned to a locally created NEW-* issue. Set on a failed result too when the create went through and a follow-up did not: the issue exists under this key"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "ops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "status"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "create_issue",
                    "update_fields",
                    "update_description",
                    "update_checklist",
                    "assign",
                    "transition",
                    "move_sprint",
                    "move_parent",
                    "create_comment",
                    "update_comment",
                    "delete_comment",
                    "create_worklog",
                    "update_worklog",
                    "delete_worklog",
                    "create_link",
                    "delete_link",
                    "upload_attachment",
                    "rename_file"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "planned",
                    "done",
                    "failed",
                    "skipped"
                  ]
                },
                "summary": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "request": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Method, path and body preview. Present for every op in --dry-run, and on a real push for one that failed, so what was sent can be read alongside the error"
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "hint": {
            "type": "string",
            "description": "What to do about `error`; absent when the issue succeeded"
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "description": "Grouping folders rebuilt by this push. Present only when a push moved an issue somewhere a folder shows it: created, transitioned, re-parented or re-sprinted."
    },
    "stale": {
      "type": "array",
      "description": "Issues refused because the server changed since base",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "description": "Things push deliberately did not do, and why",
      "items": {
        "type": "string"
      }
    },
    "verify": {
      "type": "array",
      "description": "Present under --verify: every field a pushed issue's file asked for that the server, read again after the push, does not hold. Empty when everything matched; any entry makes the exit code 10.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "field",
          "expected",
          "actual"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "The issue's key on the server (the real one, for an issue this push created)"
          },
          "field": {
            "type": "string",
            "description": "A frontmatter field name, `custom.<id>`, `description` or `checklist`"
          },
          "expected": {
            "description": "What the file asked for"
          },
          "actual": {
            "description": "What the server holds"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "The outcome in one line, so a caller need not walk the results to find it",
      "required": [
        "ok",
        "failed",
        "stale"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "description": "Issues every operation of which the server confirmed"
        },
        "failed": {
          "type": "integer"
        },
        "stale": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Issues the server had moved on from; nothing was sent for them"
        }
      }
    }
  }
}
