{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/pull/1",
  "title": "jired pull result",
  "type": "object",
  "required": [
    "schema",
    "created",
    "updated",
    "deleted",
    "conflicts",
    "unchanged"
  ],
  "properties": {
    "schema": {
      "const": "jired/pull/1"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "abort",
        "merge",
        "ours",
        "theirs"
      ]
    },
    "fetched": {
      "type": [
        "object",
        "null"
      ]
    },
    "created": {
      "$ref": "#/$defs/changeList"
    },
    "updated": {
      "$ref": "#/$defs/changeList"
    },
    "deleted": {
      "$ref": "#/$defs/changeList"
    },
    "renamed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "from",
          "to"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "unchanged": {
      "type": "integer",
      "minimum": 0
    },
    "decided": {
      "type": "array",
      "description": "Conflicts --strategy ours or theirs settled by taking that side; they were written, and nothing is left to do about them. Absent when there were none",
      "items": {
        "type": "object",
        "required": [
          "key",
          "fields"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Conflicts still standing. Non-empty means nothing was written unless strategy is merge, which wrote markers. Under ours or theirs a conflict is settled, and reported in decided instead",
      "items": {
        "type": "object",
        "required": [
          "key",
          "fields"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "description": "True when the run planned the writes but made none (--dry-run)"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Problems that did not fail the pull: a missing attachment, a grouping folder that could not be rebuilt"
    }
  },
  "$defs": {
    "changeList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changes": {
            "type": "array",
            "description": "What the pull brought in for this issue, field by field",
            "items": {
              "type": "object",
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "description": "An editable frontmatter field, custom.<id>, description, comments, worklogs, children, checklist, attachments or reporter — or updated, alone, when the server moved the issue without changing anything the file shows"
                },
                "label": {
                  "type": "string",
                  "description": "Display name of a custom field"
                },
                "from": {
                  "type": "string",
                  "description": "Previous value, shortened for display"
                },
                "to": {
                  "type": "string",
                  "description": "New value, shortened for display"
                },
                "added": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Lines, comments, worklogs or attachments added"
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Lines, comments, worklogs or attachments removed"
                }
              }
            }
          }
        }
      }
    }
  }
}
