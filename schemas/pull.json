{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/pull/1",
  "title": "jired pull result",
  "type": "object",
  "required": [
    "schema",
    "created",
    "updated",
    "deleted",
    "conflicts",
    "unchanged"
  ],
  "properties": {
    "schema": {
      "const": "jired/pull/1"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "abort",
        "merge",
        "ours",
        "theirs"
      ]
    },
    "fetched": {
      "type": [
        "object",
        "null"
      ]
    },
    "created": {
      "$ref": "#/$defs/changeList"
    },
    "updated": {
      "$ref": "#/$defs/changeList"
    },
    "deleted": {
      "$ref": "#/$defs/changeList"
    },
    "renamed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "from",
          "to"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "unchanged": {
      "type": "integer",
      "minimum": 0
    },
    "decided": {
      "type": "array",
      "description": "Conflicts --strategy ours or theirs settled by taking that side; they were written, and nothing is left to do about them. Absent when there were none",
      "items": {
        "type": "object",
        "required": [
          "key",
          "fields"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Conflicts still standing. Non-empty means nothing was written unless strategy is merge, which wrote markers. Under ours or theirs a conflict is settled, and reported in decided instead",
      "items": {
        "type": "object",
        "required": [
          "key",
          "fields"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "description": "True when the run planned the writes but made none (--dry-run)"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Problems that did not fail the pull: a missing attachment, a grouping folder that could not be rebuilt"
    },
    "state": {
      "type": "object",
      "description": "What is waiting on the user once the command is done, as `jired status` reports it: the same items under the same names. `clean` is true when every list is empty — the human output's `nothing to push, no conflicts`. Absent on a dry run, and when the pull reported conflicts of its own: those are listed under `conflicts`.",
      "required": [
        "clean",
        "new_issues",
        "dirty",
        "staged_transitions",
        "conflicts",
        "pending_ops"
      ],
      "properties": {
        "clean": {
          "type": "boolean"
        },
        "new_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "file"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "dirty": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "file",
              "fields"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lossy_touched": {
                "type": "boolean"
              }
            }
          }
        },
        "staged_transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "to"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "type": "string"
              },
              "origin": {
                "type": "string",
                "enum": [
                  "frontmatter",
                  "board-move",
                  "children"
                ]
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "field"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "resolved": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "pending_ops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "status"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "done",
                  "failed"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "changeList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changes": {
            "type": "array",
            "description": "What the pull brought in for this issue, field by field",
            "items": {
              "type": "object",
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "description": "An editable frontmatter field, custom.<id>, description, comments, worklogs, children, checklist, attachments or reporter — or updated, alone, when the server moved the issue without changing anything the file shows"
                },
                "label": {
                  "type": "string",
                  "description": "Display name of a custom field"
                },
                "from": {
                  "type": "string",
                  "description": "Previous value, shortened for display"
                },
                "to": {
                  "type": "string",
                  "description": "New value, shortened for display"
                },
                "added": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Lines, comments, worklogs or attachments added"
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Lines, comments, worklogs or attachments removed"
                }
              }
            }
          }
        }
      }
    }
  }
}
