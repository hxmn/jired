{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/create/1",
  "title": "jired create result",
  "description": "Locally created issue awaiting push",
  "type": "object",
  "required": [
    "schema",
    "key",
    "file",
    "project"
  ],
  "properties": {
    "schema": {
      "const": "jired/create/1"
    },
    "key": {
      "type": "string",
      "pattern": "^NEW-[0-9a-f]+$"
    },
    "file": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  }
}
