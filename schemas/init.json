{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/init/1",
  "title": "jired init result",
  "type": "object",
  "required": [
    "schema",
    "account",
    "workspace"
  ],
  "properties": {
    "schema": {
      "const": "jired/init/1"
    },
    "account": {
      "type": "object",
      "required": [
        "base_url",
        "deployment",
        "auth_kind"
      ],
      "properties": {
        "base_url": {
          "type": "string"
        },
        "deployment": {
          "type": "string",
          "enum": [
            "cloud",
            "datacenter"
          ]
        },
        "auth_kind": {
          "type": "string",
          "enum": [
            "api_token",
            "pat",
            "basic",
            "cookie",
            "oauth2"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_storage": {
          "type": "string",
          "enum": [
            "keyring",
            "encrypted_blob",
            "plaintext"
          ]
        },
        "secret_location": {
          "type": "string",
          "enum": [
            "keychain",
            "local_db",
            "user_config"
          ],
          "description": "Where the credential is kept (creds.storage)"
        },
        "tls": {
          "type": "object",
          "properties": {
            "ca_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "insecure": {
              "type": "boolean"
            },
            "trusted_fingerprint": {
              "type": [
                "string",
                "null"
              ],
              "description": "SHA-256 of a certificate pinned during this run"
            }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "required": [
        "root",
        "project"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "gitignore_updated": {
          "type": "boolean"
        },
        "agent_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "string"
        }
      }
    },
    "pulled": {
      "type": [
        "object",
        "null"
      ]
    },
    "state": {
      "type": "object",
      "description": "What is waiting on the user once the command is done, as `jired status` reports it: the same items under the same names. `clean` is true when every list is empty — the human output's `nothing to push, no conflicts`. Absent when setting up failed to read the workspace back.",
      "required": [
        "clean",
        "new_issues",
        "dirty",
        "staged_transitions",
        "conflicts",
        "pending_ops"
      ],
      "properties": {
        "clean": {
          "type": "boolean"
        },
        "new_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "file"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "dirty": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "file",
              "fields"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lossy_touched": {
                "type": "boolean"
              }
            }
          }
        },
        "staged_transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "to"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "type": "string"
              },
              "origin": {
                "type": "string",
                "enum": [
                  "frontmatter",
                  "board-move",
                  "children"
                ]
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "field"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "resolved": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "pending_ops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "status"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "done",
                  "failed"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
