{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jired/init/1",
  "title": "jired init result",
  "type": "object",
  "required": ["schema", "account", "workspace"],
  "properties": {
    "schema": { "const": "jired/init/1" },
    "account": {
      "type": "object",
      "required": ["base_url", "deployment", "auth_kind"],
      "properties": {
        "base_url": { "type": "string" },
        "deployment": { "type": "string", "enum": ["cloud", "datacenter"] },
        "auth_kind": {
          "type": "string",
          "enum": ["api_token", "pat", "basic", "cookie", "oauth2"]
        },
        "identity": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] },
        "account_id": { "type": ["string", "null"] },
        "secret_storage": {
          "type": "string",
          "enum": ["keyring", "encrypted_blob", "plaintext"]
        }
      }
    },
    "workspace": {
      "type": "object",
      "required": ["root", "project"],
      "properties": {
        "root": { "type": "string" },
        "project": { "type": ["string", "null"] },
        "gitignore_updated": { "type": "boolean" },
        "agent_docs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pulled": { "type": ["object", "null"] }
  }
}
